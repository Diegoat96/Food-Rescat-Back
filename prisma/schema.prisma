generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  BUSINESS
  ADMIN
}

enum BusinessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PackageStatus {
  AVAILABLE
  RESERVED
  PICKED_UP
  EXPIRED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  COMPLETED
  CANCELED
  EXPIRED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

model Reservation {
  id               String            @id @default(uuid())
  verificationCode String            @unique
  status           ReservationStatus @default(PENDING)
  paymentMethod    PaymentMethod
  clientId         String
  packageId        String
  branchId         String
  notifiedExpiring Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  client      User        @relation(fields: [clientId], references: [id])
  package     FoodPackage @relation(fields: [packageId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  rating      Rating?

  @@index([branchId, status])
  @@map("reservations")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CLIENT)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches       Branch[]
  reservations   Reservation[]
  favorites      Favorite[]
  ratings        Rating[]
  notifications  Notification[]
  businessRequests        BusinessRequest[]
  reviewedBusinessRequests BusinessRequest[] @relation("BusinessRequestReviewer")

  @@map("users")
}

model BusinessRequest {
  id                 String                @id @default(uuid())
  userId             String
  businessName       String
  address            String
  businessLicenseUrl String
  photoUrl           String?
  status             BusinessRequestStatus @default(PENDING)
  reviewedBy         String?
  reviewedAt         DateTime?
  reason             String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user     User  @relation(fields: [userId], references: [id])
  reviewer User? @relation("BusinessRequestReviewer", fields: [reviewedBy], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("business_requests")
}

model Branch {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  address      String
  city         String   @default("")
  phone        String?
  openingHours String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business     User          @relation(fields: [businessId], references: [id])
  foodPackages FoodPackage[]
  reservations Reservation[]
  favorites    Favorite[]
  ratings      Rating[]

  // Compound unique keeps ownership inside the unique key; the service fetches
  // by id first so it can answer 403 (exists but owned by another business)
  // vs 404 (does not exist).
  @@unique([id, businessId])
  @@index([businessId])
  @@map("branches")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foodPackages FoodPackage[]

  @@map("categories")
}

model FoodPackage {
  id                String        @id @default(uuid())
  name              String
  description       String?
  imageUrl          String?
  originalPrice     Decimal       @db.Decimal(10, 2)
  discountedPrice   Decimal       @db.Decimal(10, 2)
  estimatedWeightKg Decimal       @db.Decimal(8, 2)
  quantity          Int           @default(1)
  pickupDeadline    DateTime
  status            PackageStatus @default(AVAILABLE)
  publishedAt       DateTime      @default(now())
  branchId          String
  categoryId        String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  branch        Branch        @relation(fields: [branchId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  reservations  Reservation[]
  ratings       Rating[]

  @@index([branchId, status])
  @@index([categoryId, status])
  @@map("food_packages")
}

model Favorite {
  id         String   @id @default(uuid())
  customerId String
  branchId   String
  createdAt  DateTime @default(now())

  client User   @relation(fields: [customerId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([customerId, branchId])
  @@index([customerId])
  @@map("favorites")
}

model Rating {
  id            String  @id @default(uuid())
  score         Int
  comment       String?
  reservationId String? @unique
  clientId      String
  branchId      String
  packageId     String
  createdAt     DateTime @default(now())

  client      User          @relation(fields: [clientId], references: [id])
  branch      Branch        @relation(fields: [branchId], references: [id])
  package     FoodPackage   @relation(fields: [packageId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([branchId])
  @@index([packageId])
  @@unique([clientId, packageId])
  @@map("ratings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@map("notifications")
}
