# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://Foodrescat:foodrescat_dev@localhost:5432/Foodrescat?schema=public
# Required by the backend (fails fast if empty). Generate one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Comma-separated origins of the frontend, e.g. http://localhost:4200,https://foodrescat.app
CORS_ORIGIN=http://localhost:4200
# Directory where business licenses and photos uploads are stored
UPLOADS_ROOT=./uploads
# Minutes between runs of the package-expiration cron job (integer >= 1)
CRON_EXPIRACION_CADA_MINUTOS=5